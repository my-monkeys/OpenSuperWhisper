    "Whole-word replacement, case-insensitive. Write \\n in a replacement for a line break.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt ganze Wörter, ohne Beachtung der Groß-/Kleinschreibung. Schreib \\n in einen Ersatz für einen Zeilenumbruch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustitución de palabras completas, sin distinguir mayúsculas. Escribe \\n en una sustitución para un salto de línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacement de mots entiers, insensible à la casse. Écrivez \\n dans un remplacement pour un saut de ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituzione di parole intere, senza distinzione tra maiuscole e minuscole. Scrivi \\n in una sostituzione per andare a capo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituição de palavras inteiras, sem diferenciar maiúsculas. Escreva \\n em uma substituição para uma quebra de linha."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay thế nguyên từ, không phân biệt hoa thường. Viết \\n trong phần thay thế để xuống dòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整词替换，不区分大小写。在替换内容中写 \\n 表示换行。"
          }
        }
      }
    },
    "Width of the drawn notch on screens without one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite der gezeichneten Notch auf Bildschirmen ohne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho del notch dibujado en pantallas sin él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur de l'encoche dessinée sur les écrans qui n'en ont pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Larghezza del notch disegnato sugli schermi che non lo hanno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Largura do notch desenhado em telas sem notch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ rộng tai thỏ được vẽ trên màn hình không có tai thỏ."
          }
