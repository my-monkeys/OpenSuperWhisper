        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom (ex. LiteLLM maison)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome (es. LiteLLM di casa)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome (ex.: LiteLLM de casa)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên (vd: LiteLLM ở nhà)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称（例如 Home LiteLLM）"
          }
        }
      }
    },
    "Names and terms you say often. OpenSuperWhisper recognises them better and writes them the way you want.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen und Begriffe, die du oft sagst. OpenSuperWhisper erkennt sie besser und schreibt sie so, wie du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres y términos que dices a menudo. OpenSuperWhisper los reconoce mejor y los escribe como quieres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms et termes que vous dites souvent. OpenSuperWhisper les reconnaît mieux et les écrit comme vous le voulez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomi e termini che dici spesso. OpenSuperWhisper li riconosce meglio e li scrive come vuoi tu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes e termos que você diz com frequência. O OpenSuperWhisper os reconhece melhor e os escreve do jeito que você quer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên và thuật ngữ bạn hay nói. OpenSuperWhisper nhận dạng chúng tốt hơn và viết đúng như bạn muốn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你常说的人名和术语。OpenSuperWhisper 能更好地识别它们，并按你想要的方式书写。"
          }
        }
      }
    },
    "Needs a permission": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt eine Berechtigung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita un permiso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation requise"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve un'autorizzazione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer uma permissão"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần cấp quyền"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要权限"
          }
        }
      }
    },
    "Needs the Accessibility permission to see Space in every app. Space is only intercepted while a recording runs; no other keystroke is captured.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt die Berechtigung „Bedienungshilfen“, um die Leertaste in jeder App zu sehen. Die Leertaste wird nur während einer Aufnahme abgefangen; kein anderer Tastenanschlag wird erfasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita el permiso de Accesibilidad para ver Espacio en todas las apps. Espacio solo se intercepta durante una grabación; no se captura ninguna otra pulsación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite l'autorisation Accessibilité pour voir Espace dans toutes les apps. Espace n'est intercepté que pendant un enregistrement ; aucune autre frappe n'est capturée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede l'autorizzazione Accessibilità per vedere Spazio in ogni app. Spazio viene intercettato solo durante una registrazione; nessun altro tasto viene catturato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer a permissão de Acessibilidade para ver o Espaço em todos os apps. O Espaço só é interceptado durante uma gravação; nenhuma outra tecla é capturada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền Hỗ trợ tiếp cận để thấy Phím cách trong mọi ứng dụng. Phím cách chỉ bị chặn khi đang ghi âm; không phím nào khác bị ghi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限，才能在各应用中检测空格键。空格键只在录音期间被拦截，不会捕获任何其他按键。"
          }
        }
      }
    },
