    "OpenSuperWhisper %@. Updates install in place, then the app relaunches.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSuperWhisper %@. Les mises à jour s'installent sur place, puis l'app redémarre."
