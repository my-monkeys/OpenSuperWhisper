    },
    "Shorter instructions work better, especially with small models.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kürzere Anweisungen funktionieren besser, besonders bei kleinen Modellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las instrucciones cortas funcionan mejor, sobre todo con modelos pequeños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des instructions plus courtes marchent mieux, surtout avec les petits modèles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le istruzioni più brevi funzionano meglio, soprattutto con i modelli piccoli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruções mais curtas funcionam melhor, principalmente com modelos pequenos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dẫn ngắn hơn hiệu quả hơn, nhất là với mô hình nhỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指令越短效果越好，尤其是使用小模型时。"
          }
        }
      }
    },
    "So see you Thursday for the demo, right?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Also, wir sehen uns Donnerstag zur Demo, oder?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entonces nos vemos el jueves para la demo, ¿no?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donc on se voit jeudi pour la démo, c'est ça ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allora ci vediamo giovedì per la demo, giusto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Então a gente se vê quinta na demo, né?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vậy hẹn gặp thứ Năm để demo nhé, đúng không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那周四演示见，对吧？"
          }
        }
      }
    },
