    "It stays on this Mac. From Reports, export it as a zip or open a GitHub issue with the texts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie bleibt auf diesem Mac. Unter „Meldungen“ kannst du sie als ZIP exportieren oder ein GitHub-Issue mit den Texten eröffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en este Mac. Desde Informes, expórtalo como zip o abre una incidencia de GitHub con los textos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
