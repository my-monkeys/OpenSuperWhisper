    "Cleanup changed the meaning": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bereinigung hat den Sinn verändert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza cambió el sentido"
          }
        },
        "fr": {
          "stringUnit": {
