            "state": "translated",
            "value": "Fügt ein Leerzeichen an, wenn die Transkription mit einem Satzzeichen endet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un espacio cuando la transcripción termina con un signo de puntuación"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge uno spazio quando la trascrizione termina con un segno di punteggiatura"
