    "Download an on-device model first (Parakeet or Whisper) to fall back to it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade zuerst ein lokales Modell (Parakeet oder Whisper), um darauf zurückgreifen zu können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga primero un modelo local (Parakeet o Whisper) para poder recurrir a él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez d'abord un modèle local (Parakeet ou Whisper) pour pouvoir vous y replier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica prima un modello locale (Parakeet o Whisper) da usare come ripiego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe primeiro um modelo local (Parakeet ou Whisper) para poder recorrer a ele."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tải một mô hình trên máy (Parakeet hoặc Whisper) trước để dùng dự phòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先下载一个本机模型（Parakeet 或 Whisper）作为备选。"
          }
        }
      }
    },
    "Download failed. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download fehlgeschlagen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga falló. Revisa tu conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du téléchargement. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download non riuscito. Controlla la connessione e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
