          }
        }
      }
    },
    "Starts or stops recording a meeting: you and the call on two tracks, turned into a timestamped transcript on Home. Also in the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet oder stoppt die Aufnahme eines Meetings: du und der Anruf auf zwei Spuren, daraus ein Transkript mit Zeitstempeln auf der Startseite. Auch in der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia o detiene la grabación de una reunión: tú y la llamada en dos pistas, convertidas en una transcripción con marcas de tiempo en Inicio. También en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre ou arrête l'enregistrement d'une réunion : vous et l'appel sur deux pistes, transformés en transcription horodatée dans l'Accueil. Aussi dans la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia o ferma la registrazione di una riunione: tu e la chiamata su due tracce, trasformate in una trascrizione con orari nella Home. Anche nella barra dei menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia ou para a gravação de uma reunião: você e a chamada em duas faixas, transformadas em uma transcrição com horários no Início. Também na barra de menus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu hoặc dừng ghi cuộc họp: bạn và cuộc gọi trên hai kênh, thành bản ghi có mốc thời gian ở Trang chủ. Cũng có trên thanh menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始或停止录制会议：你和通话分为两条音轨，转写为带时间戳的文字记录并显示在主页。菜单栏中也有此选项。"
          }
        }
      }
    },
