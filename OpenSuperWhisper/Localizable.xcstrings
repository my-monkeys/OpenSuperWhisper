            "value": "在终端中打开"
          }
        }
      }
    },
    "Open in terminal (⌘O)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir dans le terminal (⌘O)"
          }
        },
        "zh-Hans": {
