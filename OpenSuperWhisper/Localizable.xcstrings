            "state": "translated",
            "value": "O que aconteceu e o que você esperava?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều gì đã xảy ra, và bạn mong đợi điều gì?"
          }
        },
