    "Its insertion mode, model and formatting instructions are removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfügemethode, Modell und Formatierungsanweisungen werden entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan su modo de inserción, su modelo y sus instrucciones de formato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son mode d'insertion, son modèle et ses instructions de mise en forme sont supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua modalità di inserimento, il modello e le istruzioni di formattazione vengono rimossi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de inserção, o modelo e as instruções de formatação dele são removidos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ chèn, mô hình và chỉ dẫn định dạng của nó sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其插入方式、模型和格式说明将被移除。"
          }
        }
      }
    },
    "Keep only the most recent recordings and transcriptions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die neuesten Aufnahmen und Transkriptionen behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar solo las grabaciones y transcripciones más recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne conserver que les enregistrements et transcriptions les plus récents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva solo le registrazioni e le trascrizioni più recenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
