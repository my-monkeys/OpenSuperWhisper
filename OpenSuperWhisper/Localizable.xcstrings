    "No snippets yet. Pick a phrase you would rather say than type.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Textbausteine. Wähle eine Phrase, die du lieber sagst als tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay fragmentos. Elige una frase que prefieras decir antes que escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun snippet pour l'instant. Choisissez une phrase que vous préférez dire plutôt que taper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun frammento. Scegli una frase che preferisci dire piuttosto che digitare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum trecho ainda. Escolha uma frase que você prefere dizer a digitar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có đoạn văn mẫu nào. Hãy chọn một cụm từ bạn thích nói hơn là gõ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无片段。挑一句你更愿意说而不是打的话吧。"
          }
        }
      }
    },
    "One line": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zeile"
          }
        },
        "es": {
