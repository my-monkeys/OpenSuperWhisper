          "stringUnit": {
            "state": "translated",
            "value": "发生了什么，你预期的是什么？"
          }
        }
      }
    },
    "What happens to the text between your voice and the app: cleanup, formatting, insertion.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was mit dem Text zwischen deiner Stimme und der App passiert: Bereinigung, Formatierung, Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que le pasa al texto entre tu voz y la app: limpieza, formato, inserción."
          }
        },
        "fr": {
