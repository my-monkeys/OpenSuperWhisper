      }
    },
    "See you on Thursday for the demo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir sehen uns am Donnerstag zur Demo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos vemos el jueves para la demostración."
          }
        },
