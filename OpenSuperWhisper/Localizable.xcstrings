    "Pause between keystroke bursts. Raise it if a busy input box duplicates or misplaces text.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause entre les rafales de frappe. Augmentez-la si un champ de saisie chargé duplique ou déplace du texte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
