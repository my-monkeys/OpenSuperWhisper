            "value": "Scorciatoie solo da tenere premute"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atalhos só de segurar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím tắt chỉ giữ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅按住生效的快捷键"
          }
        }
      }
    },
