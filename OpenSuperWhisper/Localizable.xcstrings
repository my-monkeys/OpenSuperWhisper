    "To hear you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dich zu hören."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para oírte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vous entendre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per sentirti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ouvir você."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để nghe bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了听到你说话。"
          }
        }
      }
    },
    "To notice right ⌥ while another app is in front. macOS asks once, when the app starts listening for the key. Only modifier keys are watched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die rechte ⌥-Taste zu bemerken, während eine andere App im Vordergrund ist. macOS fragt einmal, wenn die App beginnt, auf die Taste zu achten. Nur Modifikatortasten werden überwacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para detectar ⌥ derecha con otra app en primer plano. macOS lo pide una vez, cuando la app empieza a escuchar la tecla. Solo se vigilan las teclas modificadoras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour remarquer ⌥ droite quand une autre app est au premier plan. macOS le demande une fois, quand l'app commence à écouter la touche. Seules les touches de modification sont surveillées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per rilevare ⌥ destro quando un'altra app è in primo piano. macOS lo chiede una volta, quando l'app inizia ad ascoltare il tasto. Vengono osservati solo i tasti modificatori."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para perceber o ⌥ direito com outro app em primeiro plano. O macOS pede uma vez, quando o app começa a escutar a tecla. Só as teclas modificadoras são monitoradas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để nhận biết ⌥ phải khi ứng dụng khác đang ở phía trước. macOS hỏi một lần, khi ứng dụng bắt đầu lắng nghe phím. Chỉ các phím bổ trợ được theo dõi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在其他应用位于前台时感知右侧 ⌥ 键。应用开始监听该键时，macOS 会询问一次。仅监听修饰键。"
          }
        }
      }
    },
    "To type your words into other apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deine Worte in andere Apps zu tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para escribir tus palabras en otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour taper vos mots dans les autres apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per scrivere le tue parole nelle altre app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para digitar suas palavras em outros apps."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để gõ lời của bạn vào ứng dụng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你说的话键入其他应用。"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
