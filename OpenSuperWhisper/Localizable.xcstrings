          }
        }
      }
    },
    "Stops the model from starting a passage with a blank. On by default.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche le modèle de commencer un passage par un blanc. Activé par défaut."
