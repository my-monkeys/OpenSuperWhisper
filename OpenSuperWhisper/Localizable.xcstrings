    "Audio is uploaded to the server you set up. It does not necessarily stay on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird auf den von dir eingerichteten Server hochgeladen. Es bleibt nicht unbedingt auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se sube al servidor que hayas configurado. No tiene por qué quedarse en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio est envoyé au serveur que vous avez configuré. Il ne reste pas forcément sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio viene caricato sul server che hai configurato. Non resta necessariamente su questo Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio é enviado ao servidor que você configurou. Ele não fica necessariamente neste Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh được tải lên máy chủ bạn đã thiết lập. Nó không nhất thiết ở lại trên Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频会上传到你设置的服务器，不一定留在你这台 Mac 上。"
          }
        }
      }
    },
    "Automatic follows the detected language or your keyboard.": {
