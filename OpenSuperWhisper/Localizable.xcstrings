            "value": "Ngữ cảnh trên màn hình"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕上下文"
          }
        }
      }
    },
    "On: the model reads the sentence before your cursor. It stays on your Mac and is never saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An: Das Modell liest den Satz vor deinem Cursor. Er bleibt auf deinem Mac und wird nie gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: el modelo lee la frase anterior a tu cursor. Se queda en tu Mac y nunca se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé : le modèle lit la phrase avant votre curseur. Elle reste sur votre Mac et n'est jamais enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo: il modello legge la frase prima del cursore. Resta sul tuo Mac e non viene mai salvata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado: o modelo lê a frase antes do cursor. Ela fica no seu Mac e nunca é salva."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật: mô hình đọc câu trước con trỏ. Nội dung ở lại trên Mac và không bao giờ được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，模型会读取光标前的句子。内容只留在你的 Mac 上，绝不保存。"
          }
        }
      }
    },
    "One download, then dictation runs on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Download, dann läuft das Diktieren auf deinem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una descarga y el dictado funciona en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un téléchargement, puis la dictée tourne sur votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un download, poi la dettatura funziona sul tuo Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um download, e o ditado roda no seu Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống một lần, rồi đọc chính tả chạy trên Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载一次，之后听写就在你的 Mac 上运行。"
          }
        }
      }
    },
    "One key. Your words.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Taste. Deine Worte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tecla. Tus palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une touche. Vos mots."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tasto. Le tue parole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tecla. Suas palavras."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một phím. Lời của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个按键，说出你的话。"
          }
        }
      }
    },
    "One ⌘V. Immune to apps that redraw on every keystroke, but uses the clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einziges ⌘V. Unempfindlich gegen Apps, die bei jedem Tastenanschlag neu zeichnen, nutzt aber die Zwischenablage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo ⌘V. Inmune a las apps que se redibujan con cada pulsación, pero usa el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul ⌘V. Insensible aux apps qui se redessinent à chaque frappe, mais utilise le presse-papiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo ⌘V. Immune alle app che si ridisegnano a ogni tasto, ma usa gli appunti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único ⌘V. Imune a apps que se redesenham a cada tecla, mas usa a área de transferência."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần ⌘V. Không bị ảnh hưởng bởi ứng dụng vẽ lại sau mỗi phím gõ, nhưng dùng Bảng nhớ tạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单次 ⌘V。不受逐键重绘界面的应用影响，但会占用剪贴板。"
          }
        }
      }
    },
    "One-time system download": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmaliger System-Download"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga única del sistema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement système unique"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download di sistema unico"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Download único do sistema"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống hệ thống một lần"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性系统下载"
          }
        }
      }
    },
    "Only Parakeet shows words while you speak.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Parakeet zeigt Wörter, während du sprichst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Parakeet muestra las palabras mientras hablas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul Parakeet affiche les mots pendant que vous parlez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Parakeet mostra le parole mentre parli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o Parakeet mostra as palavras enquanto você fala."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ Parakeet hiển thị từ trong lúc bạn nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 Parakeet 能边说边显示文字。"
          }
        }
      }
    },
    "Only Whisper and servers translate. The current engine ignores this.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Whisper und Server übersetzen. Die aktuelle Engine ignoriert das."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Whisper y los servidores traducen. El motor actual lo ignora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls Whisper et les serveurs traduisent. Le moteur actuel l'ignore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducono solo Whisper e i server. Il motore attuale lo ignora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o Whisper e os servidores traduzem. O motor atual ignora isso."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ Whisper và máy chủ có thể dịch. Công cụ hiện tại bỏ qua tùy chọn này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 Whisper 和服务器支持翻译，当前引擎会忽略此项。"
          }
        }
      }
    },
    "Only Whisper can be told what to expect. The current engine has nowhere to put it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Whisper kann man sagen, was zu erwarten ist. Die aktuelle Engine hat keinen Platz dafür."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo a Whisper se le puede decir qué esperar. El motor actual no tiene dónde ponerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul Whisper peut être prévenu de ce qui l'attend. Le moteur actuel n'a nulle part où le mettre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo a Whisper si può dire cosa aspettarsi. Il motore attuale non ha dove metterlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o Whisper pode ser avisado do que esperar. O motor atual não tem onde colocar isso."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ Whisper có thể được báo trước nội dung. Công cụ hiện tại không có chỗ để dùng nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 Whisper 可以指定预期内容，当前引擎无处设置此项。"
          }
        }
      }
    },
