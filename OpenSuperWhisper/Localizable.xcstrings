    "These settings come from a newer version of OpenSuperWhisper. Update the app, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungen stammen aus einer neueren Version von OpenSuperWhisper. Aktualisiere die App und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos ajustes vienen de una versión más reciente de OpenSuperWhisper. Actualiza la app y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces réglages viennent d'une version plus récente d'OpenSuperWhisper. Mettez l'app à jour, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste impostazioni provengono da una versione più recente di OpenSuperWhisper. Aggiorna l'app, poi riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas configurações vêm de uma versão mais recente do OpenSuperWhisper. Atualize o app e tente novamente."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cài đặt này đến từ phiên bản OpenSuperWhisper mới hơn. Hãy cập nhật ứng dụng, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些设置来自更新版本的 OpenSuperWhisper。请先更新应用，然后重试。"
          }
        }
      }
    },
