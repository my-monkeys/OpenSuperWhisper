    "Stops the dictation, inserts it and presses Return. Only works while recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt das Diktat, fügt es ein und drückt Return. Funktioniert nur während der Aufnahme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene el dictado, lo inserta y pulsa Retorno. Solo funciona mientras grabas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête la dictée, l'insère et appuie sur Retour. Ne fonctionne que pendant un enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferma la dettatura, la inserisce e preme Invio. Funziona solo durante la registrazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o ditado, insere o texto e pressiona Return. Só funciona durante a gravação."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng đọc chính tả, chèn văn bản và nhấn Return. Chỉ hoạt động khi đang ghi âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止听写、插入文本并按下回车键。仅在录音期间有效。"
          }
        }
      }
    },
    "Stops the model from starting a passage with a blank. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass das Modell einen Abschnitt mit Leere beginnt. Standardmäßig an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impide que el modelo empiece un pasaje con un blanco. Activado por omisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche le modèle de commencer un passage par un blanc. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisce al modello di iniziare un passaggio con un vuoto. Attivo per impostazione predefinita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede o modelo de iniciar um trecho com um espaço em branco. Ativado por padrão."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngăn mô hình bắt đầu một đoạn bằng khoảng trống. Bật theo mặc định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止模型在段落开头留出空格。默认开启。"
          }
        }
      }
    },
    "Strips um, uh, er… before inserting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt „äh“, „ähm“, „hm“… vor dem Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita “eh”, “mmm”, “este”… antes de insertar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire les « euh », « hum », « ben »… avant l'insertion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toglie ehm, uhm, cioè… prima di inserire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove “ãh”, “hum”, “é…” antes de inserir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại bỏ “ừm”, “à”, “ờ”… trước khi chèn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入前先去掉嗯、啊、呃等语气词。"
          }
        }
      }
    },
