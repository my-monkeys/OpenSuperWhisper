    "Groq fills in the address and models. Custom takes any OpenAI-compatible server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Groq füllt Adresse und Modelle aus. „Eigene“ nimmt jeden OpenAI-kompatiblen Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Groq rellena la dirección y los modelos. Personalizado admite cualquier servidor compatible con OpenAI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Groq remplit l'adresse et les modèles. Personnalisé accepte n'importe quel serveur compatible OpenAI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Groq compila indirizzo e modelli. Personalizzato accetta qualsiasi server compatibile con OpenAI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Groq preenche o endereço e os modelos. Personalizado aceita qualquer servidor compatível com OpenAI."
          }
        },
        "vi": {
