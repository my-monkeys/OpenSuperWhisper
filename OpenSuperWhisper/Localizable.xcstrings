    "Launch without the main window. Open it from the menu bar icon.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer sans la fenêtre principale. Ouvrez-la depuis l'icône de la barre de menus."
