    "Synthetic keystrokes. Leaves the clipboard alone. Raise the pace if this app falls behind.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulierte Tastenanschläge. Lässt die Zwischenablage unberührt. Erhöhe das Tempo, wenn diese App hinterherhinkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsaciones simuladas. No toca el portapapeles. Sube el ritmo si esta app se queda atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frappes simulées. Laisse le presse-papiers intact. Augmentez le rythme si cette app prend du retard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasti simulati. Lascia intatti gli appunti. Aumenta la velocità se questa app resta indietro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Teclas simuladas. Não mexe na área de transferência. Aumente o ritmo se este app ficar para trás."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím gõ mô phỏng. Không động đến Bảng nhớ tạm. Tăng tốc độ nếu ứng dụng này bị chậm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟按键输入，不占用剪贴板。若目标应用跟不上，可调大节奏。"
          }
        }
      }
    },
