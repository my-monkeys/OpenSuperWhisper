    "Model rules need at least two models to switch between. Formatting and insertion rules work with one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellregeln brauchen mindestens zwei Modelle, zwischen denen gewechselt wird. Formatierungs- und Einfügeregeln funktionieren mit einem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas de modelo necesitan al menos dos modelos entre los que cambiar. Las reglas de formato e inserción funcionan con uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles de modèle demandent au moins deux modèles entre lesquels basculer. Les règles de mise en forme et d'insertion fonctionnent avec un seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole dei modelli richiedono almeno due modelli tra cui passare. Le regole di formattazione e inserimento funzionano con uno solo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras de modelo precisam de pelo menos dois modelos para alternar. As regras de formatação e inserção funcionam com um só."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy tắc mô hình cần ít nhất hai mô hình để chuyển đổi. Quy tắc định dạng và chèn hoạt động với một mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型规则至少需要两个模型才能切换；格式和插入规则用一个即可。"
          }
        }
      }
    },
