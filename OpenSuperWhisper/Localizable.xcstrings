      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout"
          }
        }
      }
    },
    "All set. OpenSuperWhisper can hear you and type for you.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est prêt. OpenSuperWhisper vous entend et écrit pour vous."
