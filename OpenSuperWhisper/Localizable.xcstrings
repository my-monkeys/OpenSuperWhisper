          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por sí sola necesita el permiso de Monitorización de entrada. Solo se leen las teclas modificadoras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seul nécessite l'autorisation Surveillance des entrées. Seules les touches de modification sont lues."
