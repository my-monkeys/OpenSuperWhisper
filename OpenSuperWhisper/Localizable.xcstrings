    "Whole words, any case, said alone or mid-sentence. Expanded after AI formatting, so your text is never rewritten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganze Wörter, groß oder klein, allein oder mitten im Satz gesagt. Wird nach der KI-Formatierung eingesetzt, damit dein Text nie umgeschrieben wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Palabras completas, en mayúsculas o minúsculas, dichas solas o en mitad de una frase. Se expanden tras el formato con IA, así que tu texto nunca se reescribe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mots entiers, majuscules ou non, dits seuls ou en pleine phrase. Insérés après la mise en forme par l'IA, pour que votre texte ne soit jamais réécrit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole intere, maiuscole o minuscole, dette da sole o a metà frase. Espansi dopo la formattazione IA, così il testo non viene mai riscritto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavras inteiras, maiúsculas ou minúsculas, ditas sozinhas ou no meio da frase. Expandidos depois da formatação por IA, então seu texto nunca é reescrito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguyên từ, không phân biệt hoa thường, nói riêng hoặc giữa câu. Được mở rộng sau khi định dạng bằng AI, nên văn bản của bạn không bao giờ bị viết lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整词匹配，不限大小写，单独说或句中均可。在 AI 格式化之后展开，因此绝不会改写你的文字。"
          }
        }
      }
    },
    "Written exactly as you type it here, line breaks included.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genau so geschrieben, wie du es hier tippst, mit Zeilenumbrüchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escribe tal como lo tecleas aquí, saltos de línea incluidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit exactement comme vous le tapez ici, sauts de ligne compris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scritto esattamente come lo digiti qui, a capo compresi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrito exatamente como você digitar aqui, com quebras de linha."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được viết đúng như bạn gõ ở đây, kể cả xuống dòng."
          }
