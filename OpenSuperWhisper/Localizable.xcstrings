    "A case-insensitive regular expression, applied before pasting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein regulärer Ausdruck ohne Beachtung der Groß-/Kleinschreibung, angewendet vor dem Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una expresión regular que no distingue mayúsculas, aplicada antes de pegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une expression régulière insensible à la casse, appliquée avant le collage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'espressione regolare che ignora maiuscole e minuscole, applicata prima di incollare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
