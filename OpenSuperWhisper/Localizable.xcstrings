          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已设为最大"
          }
        }
      }
    },
    "Set input volume to maximum": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre le volume d'entrée au maximum"
          }
        },
