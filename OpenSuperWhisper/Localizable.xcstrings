          }
        }
      }
    },
    "Hold %@ and say a sentence": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %@ et dites une phrase"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 %@，说一句话"
          }
        }
      }
    },
    "Hold %@ in any app, or press the record button below. Drop an audio file here to transcribe it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %@ dans n'importe quelle app, ou appuyez sur le bouton d'enregistrement ci-dessous. Déposez un fichier audio ici pour le transcrire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意应用中按住 %@，或点按下方的录音按钮。也可将音频文件拖到此处进行转写。"
          }
        }
      }
    },
    "Hold **%@**, speak, release. The text lands where you type.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez **%@**, parlez, relâchez. Le texte arrive là où vous écrivez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 **%@**，说话，松开。文字落在你打字的地方。"
          }
        }
      }
    },
    "Hold to record": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir pour enregistrer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住录音"
          }
        }
      }
    },
    "Hold to talk, release to finish. A short tap works too: tap to start, tap again to stop.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez pour parler, relâchez pour terminer. Un appui bref marche aussi : appuyez pour démarrer, appuyez à nouveau pour arrêter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话，松开结束。轻点也可以：点一下开始，再点一下停止。"
          }
        }
      }
    },
    "Hold-only shortcuts": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcis à maintenir uniquement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅按住生效的快捷键"
          }
        }
      }
    },
    "Home": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accueil"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主界面"
          }
        }
      }
    },
    "How confident the model must be to call a segment silence.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le degré de certitude requis pour que le modèle considère un segment comme du silence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型判定某段为静音所需的置信度。"
          }
        }
      }
    },
    "How long you stay quiet after the phrase before the dictation ends. Longer is safer if you use it in normal speech.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée de silence après la phrase avant que la dictée se termine. Plus long est plus sûr si vous l'employez en parlant normalement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说出该口令后安静多久，听写才会结束。若你平时说话也会带到这句口令，设长一些更保险。"
          }
        }
      }
    },
    "How the app and the recording bubble look.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aspect de l'app et de la bulle d'enregistrement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用和录音浮窗的外观。"
          }
        }
      }
    },
    "How the app starts and which language it speaks.": {
      "localizations": {
        "fr": {
