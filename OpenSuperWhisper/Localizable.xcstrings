    "Cloud — extremely fast whisper-large-v3. ⚠️ Audio is sent to Groq's servers (NOT on-device). Needs a free API key.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud — whisper-large-v3 ultra-rapide. ⚠️ L'audio est envoyé aux serveurs de Groq (PAS en local). Nécessite une clé API gratuite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud – extrem schnelles whisper-large-v3. ⚠️ Audio wird an die Server von Groq gesendet (NICHT auf dem Gerät). Benötigt einen kostenlosen API-Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nube: whisper-large-v3 extremadamente rápido. ⚠️ El audio se envía a los servidores de Groq (NO en el dispositivo). Necesita una clave de API gratuita."
          }
        },
        "it": {
          "stringUnit": {
