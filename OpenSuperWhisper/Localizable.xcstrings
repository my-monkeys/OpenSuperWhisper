    "Turbo models don't translate, whatever their documentation says. Pick a non-turbo Whisper model to translate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo-Modelle übersetzen nicht, egal was ihre Dokumentation sagt. Wähle ein Whisper-Modell ohne Turbo zum Übersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos turbo no traducen, diga lo que diga su documentación. Elige un modelo Whisper que no sea turbo para traducir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles turbo ne traduisent pas, quoi qu'en dise leur documentation. Choisissez un modèle Whisper non turbo pour traduire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli turbo non traducono, qualunque cosa dica la loro documentazione. Scegli un modello Whisper non turbo per tradurre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelos turbo não traduzem, diga o que disser a documentação. Escolha um modelo Whisper não turbo para traduzir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình turbo không dịch, bất kể tài liệu của chúng nói gì. Hãy chọn mô hình Whisper không phải turbo để dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Turbo 模型并不支持翻译，无论其文档怎么说。要翻译，请选择非 Turbo 的 Whisper 模型。"
          }
        }
      }
    },
    "Turn on Claude Code or Codex above to choose when the panel shows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte oben Claude Code oder Codex ein, um festzulegen, wann das Feld erscheint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Claude Code o Codex arriba para elegir cuándo aparece el panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Claude Code ou Codex ci-dessus pour choisir quand le panneau s'affiche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Claude Code o Codex qui sopra per scegliere quando mostrare il pannello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Claude Code ou o Codex acima para escolher quando o painel aparece."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Claude Code hoặc Codex ở trên để chọn khi nào bảng hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在上方开启 Claude Code 或 Codex，才能选择面板何时显示。"
          }
        }
      }
    },
