    "When the front app changes. Bind a model to an app below, or from the menu-bar “Model” submenu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die App im Vordergrund wechselt. Verknüpfe unten ein Modell mit einer App oder über das Untermenü „Modell“ in der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando cambia la app en primer plano. Asigna un modelo a una app abajo o desde el submenú “Modelo” de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand l'app au premier plan change. Associez un modèle à une app ci-dessous, ou depuis le sous-menu « Modèle » de la barre de menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando cambia l'app in primo piano. Associa un modello a un'app qui sotto, o dal sottomenu “Modello” della barra dei menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o app em primeiro plano muda. Associe um modelo a um app abaixo ou pelo submenu “Modelo” da barra de menus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ứng dụng phía trước thay đổi. Gán mô hình cho ứng dụng bên dưới, hoặc từ menu con “Mô hình” trên thanh menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
