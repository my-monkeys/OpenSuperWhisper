    },
    "Include app details": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joindre les infos de l'app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含应用详情"
          }
        }
      }
