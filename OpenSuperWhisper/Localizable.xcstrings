          }
        }
      }
    },
    "Will be chosen on the Style page.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf der Seite „Stil“ gewählt."
          }
        },
        "es": {
