    "New words only help recognition when “Help recognition of these words” is on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Wörter helfen der Erkennung nur, wenn „Erkennung dieser Wörter verbessern“ an ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras nuevas solo ayudan al reconocimiento si “Ayudar a reconocer estas palabras” está activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux mots n'aident la reconnaissance que si « Aider la reconnaissance de ces mots » est activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove parole aiutano il riconoscimento solo se “Aiuta il riconoscimento di queste parole” è attivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavras novas só ajudam o reconhecimento quando “Ajudar a reconhecer estas palavras” está ativado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ mới chỉ hỗ trợ nhận dạng khi bật “Hỗ trợ nhận dạng các từ này”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有开启“帮助识别这些词”，新词才会帮助识别。"
          }
        }
      }
    },
