          }
        }
      }
    },
    "Off, nothing is ever written to disk. Only the current transcription stays in memory for pasting.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, rien n'est jamais écrit sur le disque. Seule la transcription en cours reste en mémoire pour le collage."
