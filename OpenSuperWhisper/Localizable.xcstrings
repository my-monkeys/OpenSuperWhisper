    "Local fallback — the remote server was unreachable": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repli local : le serveur distant était injoignable"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaler Ersatz: Der Remote-Server war nicht erreichbar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternativa local: no se pudo contactar con el servidor remoto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripiego locale: il server remoto non era raggiungibile"
          }
        },
