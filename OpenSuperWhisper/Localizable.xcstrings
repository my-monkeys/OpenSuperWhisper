          "stringUnit": {
            "state": "translated",
            "value": "OpenSuperWhisper non può sentirti finché non consenti l'accesso al microfono nelle Impostazioni di Sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OpenSuperWhisper não consegue ouvir você até você permitir o microfone nos Ajustes do Sistema."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSuperWhisper không nghe được bạn cho đến khi bạn cho phép micrô trong Cài đặt hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中允许麦克风之前，OpenSuperWhisper 听不见你说话。"
          }
        }
      }
    },
    "OpenSuperWhisper is free and open source. A coffee on Ko-fi keeps it going.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSuperWhisper ist kostenlos und Open Source. Ein Kaffee auf Ko-fi hält es am Laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSuperWhisper es gratuito y de código abierto. Un café en Ko-fi lo mantiene vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSuperWhisper est gratuit et open source. Un café sur Ko-fi le fait vivre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSuperWhisper è gratuito e open source. Un caffè su Ko-fi lo tiene in vita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O OpenSuperWhisper é gratuito e de código aberto. Um café no Ko-fi o mantém vivo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSuperWhisper miễn phí và mã nguồn mở. Một ly cà phê trên Ko-fi giúp dự án tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
