            "value": "%@. Les règles de modèle demandent au moins deux modèles entre lesquels basculer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Le regole dei modelli richiedono almeno due modelli tra cui passare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
