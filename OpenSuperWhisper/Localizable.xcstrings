          }
        }
      }
    },
    "Work, Charity, Family…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travail, Asso, Famille…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作、公益、家庭…"
          }
        }
      }
    },
    "Your words, corrected. Nothing reworded.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos mots, corrigés. Rien de reformulé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的原话，经过纠正，不做改写。"
