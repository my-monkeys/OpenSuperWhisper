    "Pause between keystroke bursts. Raise it if a busy input box duplicates or misplaces text.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause zwischen Tastenanschlag-Schüben. Erhöhe sie, wenn ein ausgelastetes Eingabefeld Text doppelt oder falsch platziert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa entre ráfagas de pulsaciones. Súbela si un campo con mucha actividad duplica o descoloca el texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause entre les rafales de frappe. Augmentez-la si un champ de saisie chargé duplique ou déplace du texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa tra le raffiche di battitura. Aumentala se un campo di testo affollato duplica o sposta il testo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa entre rajadas de teclas. Aumente se um campo de texto carregado duplicar ou deslocar texto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng nghỉ giữa các loạt phím gõ. Tăng lên nếu ô nhập bận bị lặp hoặc sai vị trí văn bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两组按键之间的停顿时间。如果繁忙的输入框出现文字重复或错位，请调高此值。"
          }
        }
      }
    },
