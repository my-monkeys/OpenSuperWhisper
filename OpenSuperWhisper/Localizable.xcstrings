    "Click the field on the card, then press the key or combination you want. A spare mouse button works too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf das Feld in der Karte und drück dann die gewünschte Taste oder Kombination. Eine freie Maustaste geht auch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el campo de la tarjeta y pulsa la tecla o combinación que quieras. También sirve un botón libre del ratón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le champ de la carte, puis appuyez sur la touche ou la combinaison voulue. Un bouton de souris libre marche aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul campo della scheda, poi premi il tasto o la combinazione che vuoi. Va bene anche un pulsante del mouse libero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no campo do cartão e pressione a tecla ou combinação que quiser. Um botão sobrando do mouse também funciona."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm vào trường trên thẻ, rồi nhấn phím hoặc tổ hợp phím bạn muốn. Nút chuột phụ cũng được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按卡片上的输入框，再按下想要的按键或组合键。闲置的鼠标按键也可以。"
          }
        }
      }
    },
