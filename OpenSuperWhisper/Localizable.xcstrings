          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một dòng"
          }
        },
        "zh-Hans": {
