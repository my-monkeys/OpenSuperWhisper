          }
        }
      }
    },
    "To notice %@ while another app is in front. macOS asks once, when the app starts listening for the key. Only modifier keys are watched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um %@ zu bemerken, während eine andere App im Vordergrund ist. macOS fragt einmal, wenn die App beginnt, auf die Taste zu achten. Nur Modifikatortasten werden überwacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para detectar %@ con otra app en primer plano. macOS lo pide una vez, cuando la app empieza a escuchar la tecla. Solo se vigilan las teclas modificadoras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour remarquer %@ quand une autre app est au premier plan. macOS le demande une fois, quand l'app commence à écouter la touche. Seules les touches de modification sont surveillées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per rilevare %@ quando un'altra app è in primo piano. macOS lo chiede una volta, quando l'app inizia ad ascoltare il tasto. Vengono osservati solo i tasti modificatori."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para perceber %@ com outro app em primeiro plano. O macOS pede uma vez, quando o app começa a escutar a tecla. Só as teclas modificadoras são monitoradas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để nhận biết %@ khi ứng dụng khác đang ở phía trước. macOS hỏi một lần, khi ứng dụng bắt đầu lắng nghe phím. Chỉ các phím bổ trợ được theo dõi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在其他应用位于前台时察觉 %@。应用开始监听按键时，macOS 会询问一次。仅监听修饰键。"
          }
        }
      }
    },
