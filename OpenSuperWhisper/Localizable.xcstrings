    "Discards the recording in progress. Esc on its own works here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwirft die laufende Aufnahme. Esc allein funktioniert hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarta la grabación en curso. Aquí basta con Esc."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonne l'enregistrement en cours. Échap seul fonctionne ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarta la registrazione in corso. Qui funziona anche solo Esc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarta a gravação em andamento. Aqui, Esc sozinho funciona."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy bỏ bản ghi đang thực hiện. Chỉ cần Esc là được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢弃正在进行的录音。此处单独按 Esc 也可以。"
          }
        }
      }
    },
