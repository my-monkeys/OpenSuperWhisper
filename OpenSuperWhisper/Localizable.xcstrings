            "state": "translated",
            "value": "在终端中打开（⌘O）"
          }
        }
      }
    },
    "Open in %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir dans %@"
          }
        },
        "zh-Hans": {
