    "On-screen context": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmkontext"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexto en pantalla"
          }
        },
        "fr": {
          "stringUnit": {
