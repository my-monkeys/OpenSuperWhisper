    "Apple Intelligence doesn't support %@ yet, so the text is inserted without cleanup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence unterstützt %@ noch nicht, daher wird der Text ohne Bereinigung eingefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence aún no admite %@, así que el texto se inserta sin limpiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ne prend pas encore en charge cette langue (%@), le texte est donc inséré sans nettoyage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence non supporta ancora %@, quindi il testo viene inserito senza pulizia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Intelligence ainda não suporta %@, então o texto é inserido sem limpeza."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence chưa hỗ trợ %@, nên văn bản được chèn mà không dọn dẹp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 尚不支持 %@，因此文本将不经清理直接插入。"
          }
        }
      }
    },
    "Apple Intelligence is still downloading. Until then, the text is inserted without cleanup.": {
