            "state": "translated",
            "value": "Le texte inséré est traduit en anglais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo inserito viene tradotto in inglese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto inserido é traduzido para o inglês."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản được chèn sẽ được dịch sang tiếng Anh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入的文字会被翻译成英语。"
          }
        }
      }
    },
    "The language of menus and settings. Relaunch to apply.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache von Menüs und Einstellungen. Zum Übernehmen neu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de los menús y los ajustes. Reinicia para aplicarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue des menus et des réglages. Relancez pour appliquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua di menu e impostazioni. Riavvia per applicarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma dos menus e das configurações. Reinicie para aplicar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ của menu và cài đặt. Khởi động lại để áp dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单和设置使用的语言。重新启动后生效。"
          }
        }
      }
    },
    "The last words recognised": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zuletzt erkannten Wörter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las últimas palabras reconocidas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les derniers mots reconnus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ultime parole riconosciute"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As últimas palavras reconhecidas"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những từ được nhận dạng gần nhất"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后识别出的词语"
          }
        }
      }
    },
    "The microphone isn't allowed yet, so nothing will be heard. Go back a step to allow it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist noch nicht erlaubt, daher wird nichts gehört. Geh einen Schritt zurück, um es zu erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono aún no está permitido, así que no se oirá nada. Vuelve un paso atrás para permitirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro n'est pas encore autorisé, donc rien ne sera entendu. Revenez une étape en arrière pour l'autoriser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al microfono non è ancora consentito, quindi non si sentirà nulla. Torna indietro di un passo per consentirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone ainda não está permitido, então nada será ouvido. Volte uma etapa para permiti-lo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Micrô chưa được cho phép, nên sẽ không nghe được gì. Quay lại một bước để cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未允许使用麦克风，因此听不到任何声音。请返回上一步进行授权。"
          }
        }
      }
    },
    "The model chosen for this site is forgotten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das für diese Website gewählte Modell wird vergessen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se olvida el modelo elegido para este sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle choisi pour ce site est oublié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello scelto per questo sito viene dimenticato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo escolhido para este site é esquecido."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình đã chọn cho trang web này sẽ bị quên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消为此网站选择的模型。"
          }
        }
      }
    },
    "The model didn't load": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell wurde nicht geladen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo no se ha cargado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle ne s'est pas chargé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello non si è caricato"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo não carregou"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được mô hình"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型未能加载"
          }
        }
      }
    },
    "The model didn't return a usable translation, so your text was kept. Small models struggle with this; Ollama or a remote model handles it reliably.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat keine brauchbare Übersetzung geliefert, daher wurde dein Text beibehalten. Kleine Modelle tun sich damit schwer; Ollama oder ein Remote-Modell schaffen es zuverlässig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo no devolvió una traducción útil, así que se conservó tu texto. A los modelos pequeños les cuesta; Ollama o un modelo remoto lo hacen bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle n'a pas renvoyé de traduction exploitable ; votre texte a été conservé. Les petits modèles peinent sur cette tâche ; Ollama ou un modèle distant s'en sort de façon fiable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello non ha restituito una traduzione utilizzabile, quindi il testo è stato mantenuto. I modelli piccoli faticano con questo; Ollama o un modello remoto lo gestiscono in modo affidabile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo não retornou uma tradução utilizável, então seu texto foi mantido. Modelos pequenos têm dificuldade com isso; o Ollama ou um modelo remoto dá conta com confiabilidade."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình không trả về bản dịch dùng được, nên văn bản của bạn được giữ nguyên. Mô hình nhỏ thường gặp khó với việc này; Ollama hoặc mô hình từ xa xử lý đáng tin cậy hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型没有返回可用的翻译，因此保留了你的原文。小模型难以胜任；Ollama 或远程模型则能可靠完成。"
          }
        }
      }
    },
    "The model is built into macOS: downloaded per language by the system, shared across apps and updated with the OS. Nothing is stored in the app. Using a language here also sets the spoken language. macOS keeps up to 5 languages per app and rotates them beyond that.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell ist in macOS integriert: vom System pro Sprache geladen, von allen Apps geteilt und mit dem System aktualisiert. In der App wird nichts gespeichert. Eine Sprache hier zu verwenden, legt auch die gesprochene Sprache fest. macOS behält bis zu 5 Sprachen pro App und wechselt darüber hinaus durch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo está integrado en macOS: el sistema lo descarga por idioma, lo comparte entre apps y lo actualiza con el sistema. No se guarda nada en la app. Usar un idioma aquí también define el idioma hablado. macOS conserva hasta 5 idiomas por app y los va rotando a partir de ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle est intégré à macOS : téléchargé par langue par le système, partagé entre les apps et mis à jour avec l'OS. Rien n'est stocké dans l'app. Utiliser une langue ici règle aussi la langue parlée. macOS conserve jusqu'à 5 langues par app et les fait tourner au-delà."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello è integrato in macOS: scaricato per lingua dal sistema, condiviso tra le app e aggiornato con il sistema operativo. Nell'app non viene salvato nulla. Usare una lingua qui imposta anche la lingua parlata. macOS conserva fino a 5 lingue per app e oltre le fa ruotare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo é integrado ao macOS: baixado por idioma pelo sistema, compartilhado entre apps e atualizado com o sistema. Nada é armazenado no app. Usar um idioma aqui também define o idioma falado. O macOS mantém até 5 idiomas por app e faz rodízio além disso."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình được tích hợp trong macOS: hệ thống tải xuống theo từng ngôn ngữ, dùng chung giữa các ứng dụng và cập nhật cùng hệ điều hành. Ứng dụng không lưu gì. Dùng một ngôn ngữ ở đây cũng sẽ đặt ngôn ngữ nói. macOS giữ tối đa 5 ngôn ngữ cho mỗi ứng dụng và luân phiên khi vượt quá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该模型内置于 macOS：由系统按语言下载，在应用间共享，并随系统更新。应用内不存储任何内容。在此选择语言也会同时设定口语语言。macOS 为每个应用最多保留 5 种语言，超出的会自动轮换。"
          }
        }
      }
    },
    "The model that turns your voice into text. Everything runs on this Mac unless you pick a server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell, das deine Stimme in Text verwandelt. Alles läuft auf diesem Mac, außer du wählst einen Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo que convierte tu voz en texto. Todo funciona en este Mac salvo que elijas un servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle qui transforme votre voix en texte. Tout tourne sur ce Mac, sauf si vous choisissez un serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello che trasforma la tua voce in testo. Tutto funziona su questo Mac, a meno che tu non scelga un server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo que transforma sua voz em texto. Tudo roda neste Mac, a menos que você escolha um servidor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình chuyển giọng nói của bạn thành văn bản. Mọi thứ chạy trên Mac này trừ khi bạn chọn máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你的语音变成文字的模型。除非你选择服务器，否则一切都在这台 Mac 上运行。"
          }
        }
      }
    },
    "The punctuation came back already written, so there was nothing standing in for it. That usually means the model is doing it for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Satzzeichen kamen bereits ausgeschrieben zurück, es gab also nichts, das für sie stand. Meist heißt das, dass das Modell das für dich erledigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La puntuación llegó ya escrita, así que no había nada en su lugar. Suele significar que el modelo la pone por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ponctuation est revenue déjà écrite, il n'y avait donc rien à sa place. Cela signifie généralement que le modèle la gère pour vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La punteggiatura è tornata già scritta, quindi non c'era nulla al suo posto. Di solito significa che il modello la gestisce per te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pontuação voltou já escrita, então não havia nada no lugar dela. Isso geralmente significa que o modelo faz isso por você."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dấu câu trả về đã được viết sẵn, nên không có gì thay thế cho nó. Thường điều đó nghĩa là mô hình đã tự xử lý giúp bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写结果已自带标点，无需再补。这通常说明模型在自动帮你加标点。"
          }
        }
      }
    },
    "The recommendation follows your language.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Empfehlung richtet sich nach deiner Sprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recomendación sigue a tu idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recommandation suit votre langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il consiglio segue la tua lingua."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recomendação segue o seu idioma."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề xuất theo ngôn ngữ của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐会跟随你的语言。"
          }
        }
      }
    },
    "The right Option key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die rechte Wahltaste"
          }
        },
        "es": {
