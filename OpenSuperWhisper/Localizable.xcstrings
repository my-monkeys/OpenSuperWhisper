    "Starts each passage with its time, like [0.0->2.4], in dictations as well as transcribed files.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnt jeden Abschnitt mit seiner Zeit, etwa [0.0->2.4], in Diktaten wie in transkribierten Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza cada pasaje con su marca de tiempo, como [0.0->2.4], tanto en dictados como en archivos transcritos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait commencer chaque passage par son horodatage, comme [0.0->2.4], dans les dictées comme dans les fichiers transcrits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa iniziare ogni passaggio con il suo tempo, come [0.0->2.4], sia nelle dettature sia nei file trascritti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia cada trecho com seu tempo, como [0.0->2.4], tanto em ditados quanto em arquivos transcritos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu mỗi đoạn bằng thời điểm của nó, như [0.0->2.4], trong cả lần đọc chính tả lẫn tệp được phiên âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每段开头都会标注时间，如 [0.0->2.4]，听写内容和转写文件均适用。"
          }
        }
      }
    },
