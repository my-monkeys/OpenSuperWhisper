            "value": "Tutto pronto. OpenSuperWhisper ti sente e scrive per te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo pronto. O OpenSuperWhisper ouve você e digita por você."
          }
