    "Which regional model transcribes the selected language. Spelling and numbers follow it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches regionale Modell die gewählte Sprache transkribiert. Schreibweise und Zahlen richten sich danach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué modelo regional transcribe el idioma elegido. La ortografía y los números lo siguen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle régional qui transcrit la langue choisie. L'orthographe et les nombres en dépendent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello regionale che trascrive la lingua selezionata. Grafia e numeri lo seguono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
