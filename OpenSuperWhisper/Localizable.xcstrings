    "Signed in as @%@. Send saves this Mac's settings to your gist. Fetch replaces them with the saved copy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldet als @%@. „Senden“ sichert die Einstellungen dieses Mac in deinem Gist. „Abrufen“ ersetzt sie durch die gesicherte Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión iniciada como @%@. Enviar guarda los ajustes de este Mac en tu gist. Recuperar los sustituye por la copia guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté en tant que @%@. Envoyer enregistre les réglages de ce Mac dans votre gist. Récupérer les remplace par la copie enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso effettuato come @%@. Invia salva le impostazioni di questo Mac nel tuo gist. Recupera le sostituisce con la copia salvata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado como @%@. Enviar salva as configurações deste Mac no seu gist. Buscar as substitui pela cópia salva."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đăng nhập với tên @%@. Gửi sẽ lưu cài đặt của Mac này vào gist. Tải về sẽ thay thế chúng bằng bản sao đã lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录为 @%@。“发送”会把这台 Mac 的设置保存到你的 gist。“获取”会用已保存的副本替换它们。"
          }
        }
      }
    },
