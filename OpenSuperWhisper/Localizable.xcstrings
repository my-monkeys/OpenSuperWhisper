    "Hold %@ and say a sentence": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte %@ und sag einen Satz"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %@ y di una frase"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %@ et dites une phrase"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto %@ e di' una frase"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure %@ e diga uma frase"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ %@ và nói một câu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 %@，说一句话"
          }
        }
      }
    },
    "Hold %@ in any app, or press the record button below. Drop an audio file here to transcribe it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte %@ in einer beliebigen App oder drück unten die Aufnahmetaste. Leg eine Audiodatei hier ab, um sie zu transkribieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %@ en cualquier app o pulsa el botón de grabar de abajo. Suelta aquí un archivo de audio para transcribirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %@ dans n'importe quelle app, ou appuyez sur le bouton d'enregistrement ci-dessous. Déposez un fichier audio ici pour le transcrire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto %@ in qualsiasi app, o premi il pulsante di registrazione qui sotto. Trascina qui un file audio per trascriverlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure %@ em qualquer app ou pressione o botão de gravar abaixo. Solte um arquivo de áudio aqui para transcrevê-lo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ %@ trong bất kỳ ứng dụng nào, hoặc nhấn nút ghi âm bên dưới. Thả tệp âm thanh vào đây để phiên âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意应用中按住 %@，或点按下方的录音按钮。也可将音频文件拖到此处进行转写。"
          }
        }
      }
    },
    "Hold **%@**, speak, release. The text lands where you type.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte **%@**, sprich, lass los. Der Text landet dort, wo du tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén **%@**, habla y suelta. El texto llega donde escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez **%@**, parlez, relâchez. Le texte arrive là où vous écrivez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto **%@**, parla, rilascia. Il testo arriva dove scrivi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure **%@**, fale e solte. O texto chega onde você digita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ **%@**, nói, rồi thả. Văn bản xuất hiện nơi bạn đang gõ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 **%@**，说话，松开。文字落在你打字的地方。"
          }
        }
      }
    },
    "Hold to record": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aufnehmen halten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener pulsado para grabar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir pour enregistrer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto per registrare"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segurar para gravar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ để ghi âm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住录音"
          }
        }
      }
    },
    "Hold to talk, release to finish. A short tap works too: tap to start, tap again to stop.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten zum Sprechen, loslassen zum Beenden. Kurz tippen geht auch: tippen zum Starten, erneut tippen zum Stoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado para hablar y suelta para terminar. Un toque corto también funciona: toca para empezar y otra vez para parar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez pour parler, relâchez pour terminer. Un appui bref marche aussi : appuyez pour démarrer, appuyez à nouveau pour arrêter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto per parlare, rilascia per finire. Funziona anche un tocco breve: tocca per iniziare, tocca di nuovo per fermare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure para falar e solte para concluir. Um toque curto também funciona: toque para iniciar e toque de novo para parar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ để nói, thả để kết thúc. Nhấn nhanh cũng được: nhấn để bắt đầu, nhấn lại để dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话，松开结束。轻点也可以：点一下开始，再点一下停止。"
          }
        }
      }
    },
    "Hold-only shortcuts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur-Halten-Kurzbefehle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atajos solo de mantener"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
