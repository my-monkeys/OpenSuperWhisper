    "Tell us what went wrong or what you'd like. It goes straight to the team.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag uns, was schiefging oder was du dir wünschst. Es geht direkt ans Team."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos qué ha fallado o qué te gustaría. Llega directamente al equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-nous ce qui n'a pas marché ou ce que vous aimeriez. Ça arrive directement à l'équipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicci cosa non ha funzionato o cosa vorresti. Arriva direttamente al team."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte o que deu errado ou o que você gostaria. Vai direto para a equipe."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho chúng tôi biết điều gì chưa ổn hoặc bạn muốn gì. Phản hồi đến thẳng nhóm phát triển."
          }
        },
        "zh-Hans": {
