      }
    },
    "OpenSuperWhisper can't hear you until you allow the microphone in System Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenSuperWhisper ne peut pas vous entendre tant que vous n'avez pas autorisé le micro dans les Réglages Système."
          }
        },
        "zh-Hans": {
          "stringUnit": {
