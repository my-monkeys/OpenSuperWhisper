    "Several variants can point to the same word. Enter to add. \\n = line break.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Varianten können auf dasselbe Wort zeigen. Eingabetaste zum Hinzufügen. \\n = Zeilenumbruch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varias variantes pueden apuntar a la misma palabra. Intro para añadir. \\n = salto de línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs variantes peuvent pointer vers le même mot. Entrée pour ajouter. \\n = saut de ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più varianti possono puntare alla stessa parola. Invio per aggiungere. \\n = a capo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Várias variantes podem apontar para a mesma palavra. Enter para adicionar. \\n = quebra de linha."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiều biến thể có thể trỏ đến cùng một từ. Enter để thêm. \\n = xuống dòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个变体可以指向同一个词。按 Enter 添加。\\n = 换行。"
          }
        }
      }
    },
