    "See you Thursday for the demo!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis Donnerstag zur Demo!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
