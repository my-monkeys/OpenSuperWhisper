    "Sends a message or a command once the stop phrase ends the dictation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet eine Nachricht oder einen Befehl, sobald die Stopp-Phrase das Diktat beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un mensaje o un comando cuando la frase de cierre termina el dictado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie un message ou une commande quand la phrase de fin termine la dictée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un messaggio o un comando quando la frase di stop termina la dettatura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia uma mensagem ou um comando quando a frase de parada encerra o ditado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi tin nhắn hoặc lệnh khi cụm từ dừng kết thúc lần đọc chính tả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止口令结束听写后，即发送一条信息或命令。"
          }
        }
      }
    },
    "SenseVoice": {
      "localizations": {
