    "Dictate your answers to Claude Code and Codex, and hear when they are waiting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiere deine Antworten an Claude Code und Codex und erfahre, wenn sie warten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicta tus respuestas a Claude Code y Codex, y entérate cuando estén esperando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictez vos réponses à Claude Code et Codex, et soyez prévenu quand ils attendent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta le tue risposte a Claude Code e Codex, e sappi quando sono in attesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dite suas respostas ao Claude Code e ao Codex, e saiba quando eles estão esperando."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc chính tả câu trả lời cho Claude Code và Codex, và nghe báo khi chúng đang chờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你的回答听写给 Claude Code 和 Codex，并在它们等待时听到提示音。"
          }
        }
      }
    },
