    "A site rule only picks the transcription model, in Safari, Arc and other supported browsers. Insertion and formatting follow the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Website-Regel wählt nur das Transkriptionsmodell, in Safari, Arc und anderen unterstützten Browsern. Einfügen und Formatierung folgen der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla de sitio solo elige el modelo de transcripción, en Safari, Arc y otros navegadores compatibles. La inserción y el formato siguen a la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle de site choisit seulement le modèle de transcription, dans Safari, Arc et les autres navigateurs pris en charge. L'insertion et la mise en forme suivent l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regola per sito sceglie solo il modello di trascrizione, in Safari, Arc e negli altri browser supportati. Inserimento e formattazione seguono l'app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra de site escolhe só o modelo de transcrição, no Safari, Arc e outros navegadores compatíveis. A inserção e a formatação seguem o app."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy tắc trang web chỉ chọn mô hình phiên âm, trong Safari, Arc và các trình duyệt được hỗ trợ khác. Việc chèn và định dạng theo ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "站点规则只在 Safari、Arc 等受支持的浏览器中选择转写模型。插入和格式化仍遵循应用设置。"
          }
        }
      }
