          "stringUnit": {
            "state": "translated",
            "value": "Se l'IA non riesce, incolla il testo grezzo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a IA falhar, colar o texto bruto"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu AI thất bại, dán văn bản thô"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 AI 失败，则粘贴原始文本"
          }
        }
      }
    },
    "If the model errors or returns nothing usable, the transcription is inserted as it is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Modell einen Fehler meldet oder nichts Brauchbares liefert, wird die Transkription unverändert eingefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el modelo da error o no devuelve nada útil, la transcripción se inserta tal cual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le modèle renvoie une erreur ou rien d'exploitable, la transcription est insérée telle quelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il modello dà errore o non restituisce nulla di utilizzabile, la trascrizione viene inserita così com'è."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o modelo der erro ou não retornar nada utilizável, a transcrição é inserida como está."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu mô hình gặp lỗi hoặc không trả về gì dùng được, bản phiên âm sẽ được chèn nguyên trạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果模型出错或没有返回可用内容，转写文本将按原样插入。"
          }
        }
      }
    },
