    "Short press: dictation starts and keeps going, press again to stop. Held for a second or more: it stops when you release.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appui court : la dictée démarre et continue seule, appuyez à nouveau pour arrêter. Maintenu une seconde ou plus : elle s'arrête au relâchement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短按：听写开始并持续进行，再按一次停止。按住一秒或更久：松开即停止。"
          }
        }
      }
    },
