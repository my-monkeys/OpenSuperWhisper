    "A long press on a shortcut records until you release it. Off, every press starts or stops.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langes Drücken eines Kurzbefehls nimmt auf, bis du loslässt. Wenn aus, startet oder stoppt jeder Druck die Aufnahme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pulsación larga en un atajo graba hasta que lo sueltas. Desactivado, cada pulsación inicia o detiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appui long sur un raccourci enregistre jusqu'à ce que vous relâchiez. Désactivé, chaque appui démarre ou arrête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pressione prolungata su una scorciatoia registra finché non la rilasci. Se disattivato, ogni pressione avvia o ferma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque longo em um atalho grava até você soltar. Desativado, cada toque inicia ou para."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ phím tắt sẽ ghi âm đến khi bạn thả ra. Khi tắt, mỗi lần nhấn sẽ bắt đầu hoặc dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按快捷键可持续录音，直到松开。关闭时，每次按下都会开始或停止录音。"
          }
        }
      }
    },
