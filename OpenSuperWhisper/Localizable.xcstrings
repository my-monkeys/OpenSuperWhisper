          "stringUnit": {
            "state": "translated",
            "value": "Este atajo no necesita permisos adicionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci ne demande aucune autorisation supplémentaire."
          }
        },
