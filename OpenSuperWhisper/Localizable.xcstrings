    "Your preferences, dictionary and snippets in one file. API keys stay in this Mac's Keychain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einstellungen, dein Wörterbuch und deine Textbausteine in einer Datei. API-Schlüssel bleiben im Schlüsselbund dieses Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus preferencias, diccionario y fragmentos en un solo archivo. Las claves de API se quedan en el llavero de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos préférences, votre dictionnaire et vos snippets dans un seul fichier. Les clés API restent dans le trousseau de ce Mac."
          }
