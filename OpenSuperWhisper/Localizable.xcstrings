    "Press %@ in any app, or the record button below. Drop an audio file here to transcribe it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück %@ in einer beliebigen App oder unten die Aufnahmetaste. Leg eine Audiodatei hier ab, um sie zu transkribieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa %@ en cualquier app o el botón de grabar de abajo. Suelta aquí un archivo de audio para transcribirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur %@ dans n'importe quelle app, ou sur le bouton d'enregistrement ci-dessous. Déposez un fichier audio ici pour le transcrire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi %@ in qualsiasi app, o il pulsante di registrazione qui sotto. Trascina qui un file audio per trascriverlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione %@ em qualquer app ou o botão de gravar abaixo. Solte um arquivo de áudio aqui para transcrevê-lo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn %@ trong bất kỳ ứng dụng nào, hoặc nút ghi âm bên dưới. Thả tệp âm thanh vào đây để phiên âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意应用中按下 %@，或点按下面的录音按钮。将音频文件拖到此处也可转写。"
          }
        }
      }
    },
    "Press **%@**, speak, press it again. The text lands where you type.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück **%@**, sprich, drück erneut. Der Text landet dort, wo du tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa **%@**, habla y vuelve a pulsarlo. El texto llega donde escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur **%@**, parlez, appuyez à nouveau. Le texte arrive là où vous écrivez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi **%@**, parla, premilo di nuovo. Il testo arriva dove scrivi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione **%@**, fale e pressione de novo. O texto chega onde você digita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn **%@**, nói, rồi nhấn lại. Văn bản xuất hiện nơi bạn đang gõ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下 **%@**，说话，再按一次。文字会落在你打字的地方。"
          }
        }
      }
    },
    "Press Return after": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach Return drücken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsar Retorno después"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyer ensuite sur Retour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi Invio dopo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressionar Return depois"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn Return sau đó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入后按 Return"
          }
        }
      }
    },
    "Press the record button below, or set a shortcut in Settings to dictate from any app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drück unten die Aufnahmetaste oder lege in den Einstellungen einen Kurzbefehl fest, um in jeder App zu diktieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa el botón de grabar de abajo o define un atajo en Ajustes para dictar desde cualquier app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le bouton d'enregistrement ci-dessous, ou définissez un raccourci dans les Réglages pour dicter depuis n'importe quelle app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi il pulsante di registrazione qui sotto, o imposta una scorciatoia nelle Impostazioni per dettare da qualsiasi app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione o botão de gravar abaixo ou defina um atalho em Configurações para ditar de qualquer app."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn nút ghi âm bên dưới, hoặc đặt phím tắt trong Cài đặt để đọc chính tả từ mọi ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下下方的录音按钮，或在设置中设定快捷键，即可在任何应用中听写。"
          }
        }
      }
    },
    "Press to start a dictation, press again to stop.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken, um ein Diktat zu starten, erneut drücken zum Stoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa para empezar un dictado y otra vez para detenerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez pour lancer une dictée, appuyez à nouveau pour arrêter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi per avviare una dettatura, premi di nuovo per fermarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione para iniciar um ditado e de novo para parar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn để bắt đầu đọc chính tả, nhấn lại để dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下开始听写，再按一下停止。"
          }
        }
      }
    },
