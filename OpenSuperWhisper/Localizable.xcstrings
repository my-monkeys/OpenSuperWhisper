        }
      }
    },
    "We just rebuilt the whole interface. A few words about what works and what doesn't would help a lot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben gerade die ganze Oberfläche neu gebaut. Ein paar Worte dazu, was funktioniert und was nicht, würden sehr helfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabamos de rehacer toda la interfaz. Unas palabras sobre qué funciona y qué no nos ayudarían mucho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous venons de refaire toute l'interface. Quelques mots sur ce qui marche et ce qui ne marche pas nous aideraient beaucoup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo appena rifatto tutta l'interfaccia. Due parole su cosa funziona e cosa no ci aiuterebbero molto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabamos de refazer toda a interface. Algumas palavras sobre o que funciona e o que não funciona ajudariam muito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi vừa làm lại toàn bộ giao diện. Vài lời về điều gì ổn và điều gì không sẽ giúp ích rất nhiều."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们刚刚重建了整个界面。简单说说哪里好用、哪里不好用，都会帮上大忙。"
          }
        }
      }
    },
    "Add “%@” to your dictionary?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ zu deinem Wörterbuch hinzufügen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Añadir “%@” a tu diccionario?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter « %@ » à votre dictionnaire ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungere “%@” al dizionario?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar “%@” ao seu dicionário?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm “%@” vào từ điển?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将“%@”添加到词典？"
          }
        }
      }
    },
    "After a dictation, the field it went into is read again for up to a minute. A name or term you fix by hand is offered for the dictionary. It stays on your Mac, and the text read is never saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem Diktat wird das Feld, in das es ging, bis zu eine Minute lang erneut gelesen. Ein Name oder Begriff, den du von Hand korrigierst, wird fürs Wörterbuch vorgeschlagen. Es bleibt auf deinem Mac, und der gelesene Text wird nie gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras un dictado, el campo donde se insertó se vuelve a leer durante un minuto como máximo. Si corriges a mano un nombre o un término, se te propone para el diccionario. Todo se queda en tu Mac y el texto leído nunca se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après une dictée, le champ où elle a été insérée est relu pendant une minute au plus. Un nom ou un terme que vous corrigez à la main vous est proposé pour le dictionnaire. Tout reste sur votre Mac, et le texte lu n'est jamais enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo una dettatura, il campo in cui è stata inserita viene riletto per un minuto al massimo. Un nome o un termine che correggi a mano ti viene proposto per il dizionario. Resta sul tuo Mac, e il testo letto non viene mai salvato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após um ditado, o campo onde ele entrou é lido de novo por até um minuto. Um nome ou termo que você corrigir à mão é oferecido para o dicionário. Tudo fica no seu Mac, e o texto lido nunca é salvo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi đọc chính tả, trường nhận văn bản sẽ được đọc lại trong tối đa một phút. Tên hoặc thuật ngữ bạn sửa thủ công sẽ được đề xuất thêm vào từ điển. Mọi thứ ở lại trên Mac của bạn, và văn bản được đọc không bao giờ được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写后，文字所在的输入框最多会在一分钟内再次被读取。你手动修正过的名字或术语，会被建议加入词典。数据只留在你的 Mac 上，读取的文字绝不会被保存。"
          }
        }
      }
    },
    "Decide later, from Suggested in the Dictionary": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Später entscheiden, unter „Vorgeschlagen“ im Wörterbuch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidir más tarde, desde Sugerido en el Diccionario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décider plus tard, depuis Suggéré dans le dictionnaire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi più tardi, da Suggeriti nel Dizionario"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidir depois, em Sugeridas no Dicionário"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyết định sau, từ mục Gợi ý trong Từ điển"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后再决定，可从词典的“推荐”中处理"
          }
        }
      }
    },
    "Heard as": {
      "localizations": {
