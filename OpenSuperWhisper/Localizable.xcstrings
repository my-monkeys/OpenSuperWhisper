        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores mais altos deixam a decodificação mais aleatória."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị cao hơn làm việc giải mã ngẫu nhiên hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值越高，解码越随机。"
          }
        }
      }
    },
