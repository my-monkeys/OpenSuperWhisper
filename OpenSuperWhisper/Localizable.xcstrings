    "A trigger needs at least one letter or digit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Auslöser braucht mindestens einen Buchstaben oder eine Ziffer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un activador necesita al menos una letra o un dígito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un déclencheur doit contenir au moins une lettre ou un chiffre."
          }
        },
        "it": {
          "stringUnit": {
