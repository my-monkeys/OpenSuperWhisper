    "No speech threshold": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuil d'absence de parole"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无语音阈值"
          }
        }
      }
    },
    "No timeout: requests wait as long as it takes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de délai : les requêtes attendent aussi longtemps qu'il le faut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无超时：请求会一直等待直至完成。"
          }
        }
      }
    },
    "None set": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun défini"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未设置"
          }
        }
      }
    },
    "None yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun pour l'instant"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无"
          }
        }
      }
    },
    "None yet. Set on the Style page, under Per app.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune pour l'instant. À régler sur la page Style, sous Par application."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无。可在“样式”页面的“按应用”下设置。"
          }
        }
      }
    },
    "Not connected, so recording uses %@ until it is back.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non connecté : l'enregistrement utilise %@ jusqu'à son retour."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前未连接，恢复前录音将使用 %@。"
          }
        }
      }
    },
    "Not connected.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non connecté."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接。"
          }
        }
      }
    },
    "Not set": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non défini"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未设置"
          }
        }
      }
    },
    "Notch opening width": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur de l'ouverture de l'encoche"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海开口宽度"
          }
        }
      }
    },
    "Nothing customised yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de personnalisé pour l'instant"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未自定义任何内容"
          }
        }
      }
    },
    "Nothing downloading": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun téléchargement en cours"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有正在下载的内容"
          }
        }
      }
    },
    "Nothing else is sent: no dictations, audio, logs or settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d'autre n'est envoyé : ni dictées, ni audio, ni journaux, ni réglages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会发送其他任何内容：听写内容、音频、日志和设置都不会。"
          }
        }
      }
    },
    "Nothing here yet. Add a name you say often, or a word the model keeps getting wrong.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ici pour l'instant. Ajoutez un nom que vous dites souvent, ou un mot que le modèle écrit toujours mal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里还什么都没有。添加一个你常说的名字，或一个模型总认错的词。"
          }
        }
      }
    },
    "Nothing to download. A dictation too long for the model is inserted without cleanup.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à télécharger. Une dictée trop longue pour le modèle est insérée sans nettoyage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需下载任何内容。超出模型长度限制的听写将不经清理直接插入。"
          }
        }
      }
    },
    "Nothing to learn from that": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à en apprendre"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可学习的内容"
          }
        }
      }
    },
    "Nothing you dictated matches “%@”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de ce que vous avez dicté ne correspond à « %@ »."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有听写内容与“%@”匹配。"
          }
        }
      }
    },
    "Notification sound": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son de notification"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知声音"
          }
        }
      }
    },
    "Notify me when": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Me prévenir quand"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在以下情况通知我"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Off because it is inside %@, which is off. Turn that folder back on to use the panel here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, car il se trouve dans %@, qui est désactivé. Réactivez ce dossier pour utiliser le panneau ici."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因其所在的 %@ 已关闭，此项也随之关闭。重新开启该文件夹后，即可在这里使用该面板。"
          }
        }
      }
    },
    "Off, Claude Code waits in its terminal as if the plugin were not installed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, Claude Code attend dans son terminal comme si le plugin n'était pas installé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，Claude Code 会在终端中等待，如同未安装插件一样。"
          }
        }
      }
    },
    "Off, a project's agents stay in their terminal. Turning a folder off covers the projects inside it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, les agents d'un projet restent dans leur terminal. Désactiver un dossier couvre les projets qu'il contient."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，项目的 Agent 仍留在终端里。关闭某个文件夹时，其中的项目也会一并关闭。"
          }
        }
      }
    },
    "Off, nothing is ever written to disk. Only the current transcription stays in memory for pasting.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, rien n'est jamais écrit sur le disque. Seule la transcription en cours reste en mémoire pour le collage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，任何内容都不会写入磁盘。只有当前转写留在内存中，供粘贴使用。"
          }
        }
      }
    },
    "Off: nothing on screen is read.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : rien n'est lu à l'écran."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：不读取屏幕上的任何内容。"
          }
        }
      }
    },
    "Ollama": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama"
          }
        }
      }
    },
    "Ollama model": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle Ollama"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama 模型"
          }
        }
      }
    },
    "On": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开"
          }
        }
      }
    },
    "On this Mac": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur ce Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上"
          }
        }
      }
    },
    "On-screen context": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexte à l'écran"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕上下文"
          }
        }
      }
    },
    "On: the model reads the sentence before your cursor. It stays on your Mac and is never saved.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé : le modèle lit la phrase avant votre curseur. Elle reste sur votre Mac et n'est jamais enregistrée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，模型会读取光标前的句子。内容只留在你的 Mac 上，绝不保存。"
          }
        }
      }
    },
    "One download, then dictation runs on your Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un téléchargement, puis la dictée tourne sur votre Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载一次，之后听写就在你的 Mac 上运行。"
          }
        }
      }
    },
    "One key. Your words.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une touche. Vos mots."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个按键，说出你的话。"
          }
        }
      }
    },
    "One ⌘V. Immune to apps that redraw on every keystroke, but uses the clipboard.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul ⌘V. Insensible aux apps qui se redessinent à chaque frappe, mais utilise le presse-papiers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单次 ⌘V。不受逐键重绘界面的应用影响，但会占用剪贴板。"
          }
        }
      }
    },
    "One-time system download": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement système unique"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性系统下载"
          }
        }
      }
    },
    "Only Parakeet shows words while you speak.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul Parakeet affiche les mots pendant que vous parlez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 Parakeet 能边说边显示文字。"
          }
        }
      }
    },
    "Only Whisper and servers translate. The current engine ignores this.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls Whisper et les serveurs traduisent. Le moteur actuel l'ignore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 Whisper 和服务器支持翻译，当前引擎会忽略此项。"
          }
        }
      }
    },
    "Only Whisper can be told what to expect. The current engine has nowhere to put it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul Whisper peut être prévenu de ce qui l'attend. Le moteur actuel n'a nulle part où le mettre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 Whisper 可以指定预期内容，当前引擎无处设置此项。"
          }
        }
      }
    },
    "Only for servers with accounts (Groq, OpenAI…). Kept in your Keychain.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement pour les serveurs avec compte (Groq, OpenAI…). Conservée dans votre trousseau."
