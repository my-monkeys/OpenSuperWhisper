    "Cloud — extremely fast whisper-large-v3. ⚠️ Audio is sent to Groq's servers (NOT on-device). Needs a free API key.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud — whisper-large-v3 ultra-rapide. ⚠️ L'audio est envoyé aux serveurs de Groq (PAS en local). Nécessite une clé API gratuite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud – extrem schnelles whisper-large-v3. ⚠️ Audio wird an die Server von Groq gesendet (NICHT auf dem Gerät). Benötigt einen kostenlosen API-Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nube: whisper-large-v3 extremadamente rápido. ⚠️ El audio se envía a los servidores de Groq (NO en el dispositivo). Necesita una clave de API gratuita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud — whisper-large-v3 estremamente veloce. ⚠️ L'audio viene inviato ai server di Groq (NON on-device). Richiede una chiave API gratuita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuvem — whisper-large-v3 extremamente rápido. ⚠️ O áudio é enviado aos servidores da Groq (NÃO roda no dispositivo). Requer uma chave de API gratuita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cloud — whisper-large-v3 cực nhanh. ⚠️ Âm thanh được gửi đến máy chủ của Groq (KHÔNG trên thiết bị). Cần API key miễn phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端 — 极速 whisper-large-v3。⚠️ 音频会发送到 Groq 服务器（非本地）。需要免费 API 密钥。"
          }
        }
      }
    },
    "Audio is uploaded to Groq's servers — this engine is not on-device.": {
