    "Codex asks once to trust the plugin's hooks: run /hooks in Codex.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex demande une fois de faire confiance aux hooks du plugin : lancez /hooks dans Codex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 会询问一次是否信任插件的 hooks：请在 Codex 中运行 /hooks。"
          }
        }
      }
    },
    "Codex picks up the plugin by itself once it is installed for Claude Code.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex récupère le plugin tout seul une fois qu'il est installé pour Claude Code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Claude Code 安装插件后，Codex 会自动识别并使用它。"
          }
        }
      }
    },
    "Codex's questions still show in the terminal, not in the panel.": {
      "localizations": {
