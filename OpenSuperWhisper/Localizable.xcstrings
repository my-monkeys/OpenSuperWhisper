    "Reshape the text through AI cleanup, based on the app you dictate into, such as “at Rob” → “@Rob” in Slack. Uses the AI cleanup backend set in Settings → Text & AI.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formt den Text per KI-Bereinigung um, je nach App, in die du diktierst, z. B. „at Rob“ → „@Rob“ in Slack. Nutzt das unter Einstellungen → Text & KI festgelegte Backend für die KI-Bereinigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reformula el texto con la limpieza con IA según la app en la que dictas, como “at Rob” → “@Rob” en Slack. Usa el motor de limpieza con IA definido en Ajustes → Texto e IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remanie le texte via le nettoyage IA selon l'app dans laquelle vous dictez, par exemple « at Rob » → « @Rob » dans Slack. Utilise le moteur de nettoyage IA défini dans Réglages → Texte & IA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimodella il testo con la pulizia IA in base all'app in cui detti, ad esempio “at Rob” → “@Rob” in Slack. Usa il motore di pulizia IA impostato in Impostazioni → Testo e IA."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reformula o texto com a limpeza por IA conforme o app em que você dita, como “at Rob” → “@Rob” no Slack. Usa o motor de limpeza por IA definido em Configurações → Texto e IA."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉnh lại văn bản qua Dọn dẹp AI, dựa trên ứng dụng bạn đang đọc chính tả, ví dụ “at Rob” → “@Rob” trong Slack. Dùng công cụ Dọn dẹp AI đặt trong Cài đặt → Văn bản & AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 AI 清理重塑文字，并根据听写的目标应用调整，例如在 Slack 中把“艾特 Rob”改为“@Rob”。使用“设置 → 文字与 AI”中设定的 AI 清理后端。"
          }
        }
      }
    },
    "Resumes what was actually playing when you stop.": {
