    "You can change it, or add more shortcuts, in Settings later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst ihn später in den Einstellungen ändern oder weitere Kurzbefehle hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiarlo, o añadir más atajos, más adelante en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez le modifier, ou ajouter d'autres raccourcis, plus tard dans les Réglages."
