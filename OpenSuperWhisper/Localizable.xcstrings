    },
    "Without a scheme, plain http:// (unencrypted) is used. Type https:// for TLS.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Schema wird einfaches http:// (unverschlüsselt) verwendet. Gib https:// für TLS ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin esquema, se usa http:// simple (sin cifrar). Escribe https:// para TLS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans schéma, http:// simple (non chiffré) est utilisé. Tapez https:// pour TLS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza schema, viene usato http:// semplice (non cifrato). Scrivi https:// per TLS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem esquema, é usado http:// simples (sem criptografia). Digite https:// para TLS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không có giao thức, http:// thường (không mã hóa) sẽ được dùng. Nhập https:// để dùng TLS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不写协议时，将使用普通 http://（不加密）。如需 TLS，请输入 https://。"
          }
        }
      }
    },
    "Without it, the shortcuts don't work outside the app and the text can't be typed where you write.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne sie funktionieren die Kurzbefehle außerhalb der App nicht, und der Text kann nicht dort getippt werden, wo du schreibst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin él, los atajos no funcionan fuera de la app y el texto no puede escribirse donde escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans elle, les raccourcis ne fonctionnent pas hors de l'app et le texte ne peut pas être tapé là où vous écrivez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza di essa, le scorciatoie non funzionano fuori dall'app e il testo non può essere digitato dove scrivi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ela, os atalhos não funcionam fora do app e o texto não pode ser digitado onde você escreve."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có quyền này, phím tắt không hoạt động bên ngoài ứng dụng và văn bản không thể gõ vào nơi bạn viết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有它，快捷键在应用外不起作用，文字也无法输入到你书写的地方。"
          }
        }
      }
    },
    "Words": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörter"
          }
        },
        "es": {
