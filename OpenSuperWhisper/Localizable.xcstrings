    "Press %@ in any app, or the record button below. Drop an audio file here to transcribe it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur %@ dans n'importe quelle app, ou sur le bouton d'enregistrement ci-dessous. Déposez un fichier audio ici pour le transcrire."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意应用中按下 %@，或点按下面的录音按钮。将音频文件拖到此处也可转写。"
          }
        }
      }
    },
    "Press **%@**, speak, press it again. The text lands where you type.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur **%@**, parlez, appuyez à nouveau. Le texte arrive là où vous écrivez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
